# ============================================================================
# 复制为 .env。所有变量前缀 ICS_，嵌套用双下划线：ICS_RETRIEVAL__RRF_K
# 🔴 配置在进程启动时校验，配错就起不来——不是跑到第一个请求才炸。
# ============================================================================

ICS_ENV=local
ICS_LOG_LEVEL=INFO
ICS_LOG_JSON=false

# ---- 数据库（向量 + 词法 + 会话记忆 + 待确认单都在这里）----
ICS_DATABASE_URL=postgresql://ics:ics@localhost:5432/ics
ICS_REDIS_URL=redis://localhost:6379/0
ICS_PG_POOL_MIN=4
# 🔴 一次请求可能持有 2 条连接（检索 + checkpointer），池要留余量
ICS_PG_POOL_MAX=20

# ---- 模型别名 → 真实模型 ----
# 🔴 上层代码只认别名，换厂商只改这几行，不改一行业务代码。
ICS_MODEL_CHAT_MAIN=ollama/qwen3
ICS_MODEL_CHAT_CHEAP=ollama/qwen3
ICS_MODEL_EMBED_MAIN=bge-m3
ICS_MODEL_RERANK_MAIN=BAAI/bge-reranker-v2-m3
# 换成 DeepSeek 只需下面三行（🔴 但 DeepSeek 无 /embeddings，嵌入必须另找提供方）
# ICS_MODEL_CHAT_MAIN=deepseek/deepseek-flash
# ICS_LLM_API_BASE=https://api.deepseek.com
# ICS_LLM_API_KEY=sk-...

ICS_EMBED_API_BASE=http://localhost:11434
ICS_EMBED_API_KEY=
ICS_MAX_CONCURRENCY_PER_MODEL=16
ICS_REQUEST_TIMEOUT_S=90
ICS_EMBED_BATCH_SIZE=64
# 🔴 本地重排模型不是线程安全的，限并发
ICS_RERANK_CONCURRENCY=2

# ---- 预算与缓存 ----
# 🔴 与 Agent 步数上限是两回事：步数管循环次数，预算管花销。
ICS_DEFAULT_BUDGET_TOKENS=50000
ICS_CACHE_TTL_S=300
ICS_EMBED_CACHE_TTL_S=86400

# ---- 检索 ----
ICS_RETRIEVAL__DENSE_TOP_K=50
ICS_RETRIEVAL__SPARSE_TOP_K=50
ICS_RETRIEVAL__RRF_K=60
ICS_RETRIEVAL__RERANK_TOP_N=5
ICS_RETRIEVAL__MAX_CONTEXT_TOKENS=4000
# 🔴 pgvector 默认 ef_search=40：带过滤检索时实际返回数会远少于 top_k
ICS_RETRIEVAL__HNSW_EF_SEARCH=100
# 🔴 带过滤的 ANN 必开迭代扫描：off / strict_order / relaxed_order
ICS_RETRIEVAL__ITERATIVE_SCAN=relaxed_order

# ---- 可观测 ----
# 🔴 绑 OTel 而非某个厂商 SDK：Langfuse / Phoenix / Jaeger 都接 OTLP，
#    换后端只改 endpoint，埋点代码一行不动。
ICS_OTEL_ENABLED=false
ICS_OTEL_ENDPOINT=http://localhost:4318/v1/traces
# ICS_OTEL_HEADERS=Authorization=Bearer xxx

# ---- 资产目录 ----
ICS_PROMPTS_DIR=prompts
ICS_AGENTS_DIR=agents

# ---- docker compose ----
# 🔴 compose v2.2.x 不支持顶层 name:，项目名用这个变量固定
COMPOSE_PROJECT_NAME=ics
# 宿主机端口（避免与本机其他实例冲突）
ICS_PG_PORT=5433
ICS_REDIS_PORT=6380
ICS_OLLAMA_PORT=11434
ICS_API_PORT=8000
ICS_WEB_PORT=3000
